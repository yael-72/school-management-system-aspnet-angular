# Copy to .env (which git ignores) and change the values. Used only by docker-compose.yml.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=Change_Me_Local_Only_1

# Key that signs the login tokens: at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
